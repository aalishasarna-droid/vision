# ==========================================
# Vision Frontend (React + Vite) Configuration (Template)
# ==========================================

# Base URL for Backend API (Proxied through Vite dev server or direct URL)
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_TITLE=Vision — TinyML Acoustic Anomaly Detector
VITE_APP_VERSION=1.0.0

# Edge Model Telemetry Limits
VITE_MODEL_BUDGET_KB=256
VITE_DEFAULT_THRESHOLD=0.085

# Enable realistic simulation if backend server is not running
VITE_ENABLE_FALLBACK_SIMULATION=true
